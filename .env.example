# Environment variables for Gulmohar Analytics & Petpooja Integration

# -----------------------------------------------------------------------------
# 1. APPLICATION DATA SOURCE SELECTION
# -----------------------------------------------------------------------------
# Controls whether dashboard analytics consume local mock data or a live database.
# Options: "mock" (default, active for development) | "database" (pending VPS deployment)
# Note: When set to "database", loaders fail explicitly until database drivers are connected.
DATA_SOURCE=mock

# -----------------------------------------------------------------------------
# 2. TEMPORARY STAGING WEBHOOK PERSISTENCE (Supabase - Server-side Only)
# -----------------------------------------------------------------------------
# Temporary staging Supabase instance used for Vercel demo webhook testing.
# NEVER prefix with NEXT_PUBLIC_ or expose to client browsers.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# -----------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL / Prisma ORM)
# -----------------------------------------------------------------------------
# Connection URL for PostgreSQL used by Prisma Client and Prisma Migrate.
#
# Local Development (Docker Compose: compose.yaml):
#   Container: gulmohar-postgres | Database: gulmohar_dev | User: gulmohar_app
#   Stored in ignored local .env or .env.local file:
#   DATABASE_URL="postgresql://gulmohar_app:your_local_password@localhost:5432/gulmohar_dev"
#
# Production (Hostinger KVM2 VPS Docker Network):
#   Container: shared-postgres | Network: shared-db-net
#   Database: gulmohar_analytics | User: gulmohar_app
#   DATABASE_URL="postgresql://gulmohar_app:your_secure_password@shared-postgres:5432/gulmohar_analytics"
#
DATABASE_URL=postgresql://gulmohar_app:your_password@localhost:5432/gulmohar_dev

# -----------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY
# -----------------------------------------------------------------------------
# Secret key used for signing session cookies (minimum 32 characters in production)
SESSION_SECRET=gulmohar-dev-session-secret-key-at-least-32-chars-long

# Production Database Bootstrap Configuration (Required ONLY when running `npm run db:bootstrap`)
# - CONFIRM_PRODUCTION_BOOTSTRAP must be explicitly set to "YES" to confirm intent.
# - PROD_ADMIN_PASSWORD must be at least 12 characters. Never hardcode or commit.
CONFIRM_PRODUCTION_BOOTSTRAP=
PROD_ADMIN_PASSWORD=
PROD_ADMIN_USERNAME=admin
PROD_ADMIN_NAME="Administrator"

# Development Seed Passwords (Required ONLY when running `prisma/seeds/seed.dev.ts`)
# Never set these in production; seed script refuses execution if NODE_ENV=production.
DEV_ADMIN_PASSWORD=
DEV_MANAGER_PASSWORD=
DEV_OPERATOR_PASSWORD=

# -----------------------------------------------------------------------------
# 5. PETPOOJA GLOBAL API (Push Webhook)
# -----------------------------------------------------------------------------
# Static token configured between Petpooja POS and our webhook (optional in Petpooja docs).
# Leave empty if testing without authentication during initial demo push.
PETPOOJA_WEBHOOK_TOKEN=

# -----------------------------------------------------------------------------
# 5. PETPOOJA GET ORDERS API (Pull Model - Future Phase)
# -----------------------------------------------------------------------------
# Production endpoint provided by Petpooja team upon activation
PETPOOJA_GET_ORDERS_ENDPOINT=https://api.petpooja.com/orders/data

# Credentials provisioned per restaurant outlet upon production onboarding
PETPOOJA_REST_ID=
PETPOOJA_APP_KEY=
PETPOOJA_APP_SECRET=
PETPOOJA_ACCESS_TOKEN=
