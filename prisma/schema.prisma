generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String            @unique
  name             String
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  breakageItems    BreakageItem[]
  breakageReasons  BreakageReason[]
  categories       Category[]
  ingredients      Ingredient[]
  outlets          Outlet[]
  preparationItems PreparationItem[]
  products         Product[]
  users            UserAccount[]
  wastageReasons   WastageReason[]

  @@map("organizations")
}

model Outlet {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String                 @map("organization_id") @db.Uuid
  code            String                 @unique
  name            String
  city            String
  address         String?
  timezone        String                 @default("Asia/Kolkata")
  petpoojaRestId  String?                @unique @map("petpooja_rest_id")
  isActive        Boolean                @default(true) @map("is_active")
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  breakageRecords BreakageRecord[]
  departments     Department[]
  employees       Employee[]
  productSettings OutletProductSetting[]
  organization    Organization           @relation(fields: [organizationId], references: [id])
  preparationLogs PreparationLog[]
  salesOrders     SalesOrder[]
  userAssignments UserOutletAssignment[]
  wastageRecords  WastageRecord[]

  @@index([organizationId])
  @@map("outlets")
}

model UserAccount {
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String                 @map("organization_id") @db.Uuid
  username            String                 @unique
  passwordHash        String                 @map("password_hash")
  role                AppRole
  displayName         String                 @map("display_name")
  isActive            Boolean                @default(true) @map("is_active")
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  recordedBreakage    BreakageRecord[]       @relation("BreakageRecordedBy")
  recordedPreparation PreparationLog[]       @relation("PreparationRecordedBy")
  organization        Organization           @relation(fields: [organizationId], references: [id])
  outletAssignments   UserOutletAssignment[]
  sessions            UserSession[]
  recordedWastage     WastageRecord[]        @relation("WastageRecordedBy")

  @@index([organizationId])
  @@map("user_accounts")
}

model UserSession {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String      @map("user_id") @db.Uuid
  sessionTokenHash String      @unique @map("session_token_hash")
  ipAddress        String?     @map("ip_address")
  userAgent        String?     @map("user_agent")
  expiresAt        DateTime    @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime?   @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  lastActiveAt     DateTime    @default(now()) @map("last_active_at") @db.Timestamptz(6)
  user             UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionTokenHash])
  @@index([expiresAt])
  @@map("user_sessions")
}

model LoginAttempt {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier     String    @unique
  attempts       Int       @default(1)
  lockUntil      DateTime? @map("lock_until") @db.Timestamptz(6)
  firstAttemptAt DateTime  @default(now()) @map("first_attempt_at") @db.Timestamptz(6)
  lastAttemptAt  DateTime  @default(now()) @map("last_attempt_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("login_attempts")
}

model UserOutletAssignment {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  outletId  String      @map("outlet_id") @db.Uuid
  isDefault Boolean     @default(false) @map("is_default")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  outlet    Outlet      @relation(fields: [outletId], references: [id], onDelete: Cascade)
  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, outletId])
  @@index([userId])
  @@index([outletId])
  @@map("user_outlet_assignments")
}

model Department {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId           String            @map("outlet_id") @db.Uuid
  departmentCode     String            @map("department_code")
  name               String
  benchmarkHeadcount Int               @default(0) @map("benchmark_headcount")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  isActive           Boolean           @default(true) @map("is_active")
  breakageRecords    BreakageRecord[]
  outlet             Outlet            @relation(fields: [outletId], references: [id])
  employees          Employee[]
  preparationItems   PreparationItem[]
  preparationLogs    PreparationLog[]
  wastageRecords     WastageRecord[]

  @@unique([outletId, departmentCode])
  @@index([outletId])
  @@map("departments")
}

model Employee {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId         String     @map("outlet_id") @db.Uuid
  departmentId     String     @map("department_id") @db.Uuid
  employeeCode     String     @map("employee_code")
  name             String
  role             String
  monthlySalary    Decimal    @map("monthly_salary") @db.Decimal(12, 2)
  employmentStatus String     @default("active") @map("employment_status")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  department       Department @relation(fields: [departmentId], references: [id])
  outlet           Outlet     @relation(fields: [outletId], references: [id])

  @@unique([outletId, employeeCode])
  @@index([outletId])
  @@index([departmentId])
  @@map("employees")
}

model Category {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  categoryCode   String       @map("category_code")
  name           String
  displayOrder   Int          @default(0) @map("display_order")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id])
  products       Product[]

  @@unique([organizationId, categoryCode])
  @@map("categories")
}

model Product {
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String                 @map("organization_id") @db.Uuid
  categoryId          String                 @map("category_id") @db.Uuid
  productCode         String                 @map("product_code")
  name                String
  defaultSellingPrice Decimal                @map("default_selling_price") @db.Decimal(10, 2)
  foodCost            Decimal?               @map("food_cost") @db.Decimal(10, 2)
  unit                String                 @default("portion")
  preparationType     PreparationType        @default(BATCH) @map("preparation_type")
  isActive            Boolean                @default(true) @map("is_active")
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  outletSettings      OutletProductSetting[]
  category            Category               @relation(fields: [categoryId], references: [id])
  organization        Organization           @relation(fields: [organizationId], references: [id])
  recipes             RecipeItem[]
  orderItems          SalesOrderItem[]

  @@unique([organizationId, productCode])
  @@index([organizationId, categoryId])
  @@map("products")
}

model Ingredient {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  ingredientCode String       @map("ingredient_code")
  name           String
  unit           String
  defaultCost    Decimal      @map("default_cost") @db.Decimal(12, 2)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  isActive       Boolean      @default(true) @map("is_active")
  organization   Organization @relation(fields: [organizationId], references: [id])
  recipeItems    RecipeItem[]

  @@unique([organizationId, ingredientCode])
  @@map("ingredients")
}

model RecipeItem {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId       String     @map("product_id") @db.Uuid
  ingredientId    String     @map("ingredient_id") @db.Uuid
  quantityPerUnit Decimal    @map("quantity_per_unit") @db.Decimal(10, 4)
  ingredient      Ingredient @relation(fields: [ingredientId], references: [id])
  product         Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId])
  @@index([productId])
  @@map("recipe_items")
}

model OutletProductSetting {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId       String   @map("outlet_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  priceOverride  Decimal? @map("price_override") @db.Decimal(10, 2)
  isAvailable    Boolean  @default(true) @map("is_available")
  petpoojaItemId String?  @map("petpooja_item_id")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  outlet         Outlet   @relation(fields: [outletId], references: [id])
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([outletId, productId])
  @@index([outletId])
  @@map("outlet_product_settings")
}

model PreparationItem {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  departmentId    String?          @map("department_id") @db.Uuid
  name            String
  code            String
  unit            String
  standardCost    Decimal?         @map("standard_cost") @db.Decimal(12, 2)
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  department      Department?      @relation(fields: [departmentId], references: [id])
  organization    Organization     @relation(fields: [organizationId], references: [id])
  preparationLogs PreparationLog[]
  wastageRecords  WastageRecord[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([departmentId])
  @@map("preparation_items")
}

model PreparationLog {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId          String          @map("outlet_id") @db.Uuid
  preparationItemId String          @map("preparation_item_id") @db.Uuid
  departmentId      String?         @map("department_id") @db.Uuid
  recordedById      String          @map("recorded_by_id") @db.Uuid
  date              DateTime        @db.Date
  quantity          Decimal         @db.Decimal(10, 3)
  notes             String?
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  department        Department?     @relation(fields: [departmentId], references: [id])
  outlet            Outlet          @relation(fields: [outletId], references: [id])
  preparationItem   PreparationItem @relation(fields: [preparationItemId], references: [id])
  recordedBy        UserAccount     @relation("PreparationRecordedBy", fields: [recordedById], references: [id])

  @@index([outletId, date])
  @@index([preparationItemId])
  @@index([recordedById])
  @@map("preparation_logs")
}

model WastageRecord {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId          String          @map("outlet_id") @db.Uuid
  recordedById      String          @map("recorded_by_id") @db.Uuid
  date              DateTime        @db.Date
  wastedQuantity    Decimal         @map("wasted_quantity") @db.Decimal(10, 3)
  estimatedCost     Decimal?        @map("estimated_cost") @db.Decimal(12, 2)
  reason            String
  notes             String?
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  departmentId      String?         @map("department_id") @db.Uuid
  preparationItemId String          @map("preparation_item_id") @db.Uuid
  unitCost          Decimal?        @map("unit_cost") @db.Decimal(12, 2)
  department        Department?     @relation(fields: [departmentId], references: [id])
  outlet            Outlet          @relation(fields: [outletId], references: [id])
  preparationItem   PreparationItem @relation(fields: [preparationItemId], references: [id])
  recordedBy        UserAccount     @relation("WastageRecordedBy", fields: [recordedById], references: [id])

  @@index([outletId, date])
  @@index([preparationItemId])
  @@index([recordedById])
  @@map("wastage_records")
}

model BreakageRecord {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId     String      @map("outlet_id") @db.Uuid
  departmentId String      @map("department_id") @db.Uuid
  recordedById String      @map("recorded_by_id") @db.Uuid
  date         DateTime    @db.Date
  item         String
  brokenQty    Int         @map("broken_qty")
  unitCost     Decimal?    @map("unit_cost") @db.Decimal(12, 2)
  totalCost    Decimal?    @map("total_cost") @db.Decimal(12, 2)
  reason       String
  notes        String?
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  department   Department  @relation(fields: [departmentId], references: [id])
  outlet       Outlet      @relation(fields: [outletId], references: [id])
  recordedBy   UserAccount @relation("BreakageRecordedBy", fields: [recordedById], references: [id])

  @@index([outletId, date])
  @@index([departmentId])
  @@index([recordedById])
  @@map("breakage_records")
}

model BreakageItem {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  code            String
  name            String
  category        String       @default("Tableware")
  replacementCost Decimal?     @map("replacement_cost") @db.Decimal(12, 2)
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("breakage_items")
}

model WastageReason {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  code           String
  label          String
  description    String?
  displayOrder   Int          @default(0) @map("display_order")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("wastage_reasons")
}

model BreakageReason {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  code           String
  label          String
  description    String?
  displayOrder   Int          @default(0) @map("display_order")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("breakage_reasons")
}

model SalesOrder {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId        String           @map("outlet_id") @db.Uuid
  petpoojaOrderId String           @map("petpooja_order_id")
  orderDate       DateTime         @map("order_date") @db.Date
  orderedAt       DateTime         @map("ordered_at") @db.Timestamptz(6)
  orderType       String           @map("order_type")
  coreTotal       Decimal?         @map("core_total") @db.Decimal(12, 2)
  taxTotal        Decimal?         @map("tax_total") @db.Decimal(12, 2)
  discountTotal   Decimal?         @map("discount_total") @db.Decimal(12, 2)
  totalAmount     Decimal?         @map("total_amount") @db.Decimal(12, 2)
  financialStatus String           @default("pending") @map("financial_status")
  matchingStatus  String           @default("unmatched") @map("matching_status")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  status          String           @default("Success")
  items           SalesOrderItem[]
  outlet          Outlet           @relation(fields: [outletId], references: [id])

  @@unique([outletId, petpoojaOrderId])
  @@index([outletId, orderDate])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salesOrderId String     @map("sales_order_id") @db.Uuid
  productId    String?    @map("product_id") @db.Uuid
  itemName     String     @map("item_name")
  quantity     Decimal    @db.Decimal(10, 3)
  unitPrice    Decimal    @map("unit_price") @db.Decimal(10, 2)
  totalAmount  Decimal    @map("total_amount") @db.Decimal(12, 2)
  itemTax      Decimal?   @map("item_tax") @db.Decimal(10, 2)
  itemDiscount Decimal?   @map("item_discount") @db.Decimal(10, 2)
  product      Product?   @relation(fields: [productId], references: [id])
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([salesOrderId])
  @@index([productId])
  @@map("sales_order_items")
}

enum AppRole {
  ADMIN    @map("admin")
  MANAGER  @map("manager")
  OPERATOR @map("operator")
}

enum PreparationType {
  BATCH       @map("batch")
  FRESH_DAILY @map("fresh_daily")
}
